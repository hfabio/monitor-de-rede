<?xml version="1.0" encoding="utf-8"?>
<!-- Configuração de artefato do SignPath (slug: "exe"). Cole no projeto
     "monitor-de-rede" do SignPath. O GitHub Actions envia um .zip com o
     arquivo na raiz e o parâmetro "version" (ex.: 0.7.0). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="MonitorRede-windows-x64.exe" product-name="Monitor de Rede" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
